# PRISM-PY Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# NVIDIA LLM API Configuration
# ============================================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_ACTUAL_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=3
NVIDIA_TEMPERATURE=0.1
NVIDIA_MAX_TOKENS=4096

# ============================================================================
# Embedding Model Configuration (reuses existing e5-base-v2)
# ============================================================================
EMBEDDING_MODEL=intfloat/e5-base-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# ============================================================================
# Chunking Configuration (reuses existing settings)
# ============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=300

# ============================================================================
# Retrieval Configuration
# ============================================================================
TOP_K=5
RELEVANCE_THRESHOLD=0.25
HYBRID_RANKING_STRATEGY=rrf
MAX_QUERY_EXPANSIONS=4
MAX_DECOMPOSED_QUESTIONS=5

# ============================================================================
# FAISS Vector Store Configuration (reuses existing)
# ============================================================================
FAISS_INDEX_TYPE=auto
FAISS_INDEX_DIR=./vectorstore/faiss_index
FAISS_METADATA_PATH=./vectorstore/faiss_index/index_metadata.pkl

# ============================================================================
# Document Ingestion Configuration
# ============================================================================
OCR_ENABLED=true
MAX_UPLOAD_SIZE_MB=25
MAX_ARCHIVE_FILES=200

# ============================================================================
# Routing and Classification
# ============================================================================
ROUTE_CONFIDENCE_THRESHOLD=0.75
DEFAULT_ROUTE=1

# ============================================================================
# Jurisdiction-Aware Ranking
# ============================================================================
JURISDICTION_WEIGHT_DECAY=0.2

# ============================================================================
# Application Settings
# ============================================================================
LOG_LEVEL=INFO
API_BEARER_TOKEN=9f40f077e610d431226b59eec99652153ccad94769da6779cc01725731999634

# ============================================================================
# Notes:
# ============================================================================
# 1. NEVER commit this file with real API keys to version control
# 2. Keep your .env file secure and private
# 3. The NVIDIA_MODEL_ID can be changed to other supported models:
#    - meta/llama-3.1-70b-instruct (recommended, 128K context)
#    - meta/llama-3.1-8b-instruct (faster, 128K context)
#    - mistralai/mixtral-8x7b-instruct-v0.1 (32K context)
# 4. Visit https://build.nvidia.com/explore/discover for available models
# 5. Lower NVIDIA_TEMPERATURE (e.g., 0.1) for more deterministic outputs
# 6. Increase MAX_TOKENS if you need longer responses
